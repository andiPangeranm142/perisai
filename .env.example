# Firebase web app config — copy to `.env` and fill in real values.
# NEVER commit a filled-in `.env`. Get these from Firebase Console >
# Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check debug tokens are NOT read from env by the app: a VITE_* token
# would be inlined into the production bundle. For local App Check testing,
# set self.FIREBASE_APPCHECK_DEBUG_TOKEN manually in the browser console
# before the app loads (register the token first in Firebase Console >
# App Check > Apps > Manage debug tokens).

# Optional: reCAPTCHA Enterprise site key for App Check in production.
# VITE_RECAPTCHA_SITE_KEY=
